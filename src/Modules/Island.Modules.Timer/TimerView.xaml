<UserControl x:Class="Island.Modules.Timer.TimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Secondary" Color="#9A9A9A" />

        <!-- 小圓角膠囊按鈕(預設時間、模式切換) -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Secondary}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="9" Padding="9,2" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.AccentDim}" />
                                <Setter Property="Foreground" Value="{DynamicResource Island.AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Island.AccentSoft}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="17" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="{DynamicResource Island.AccentDim}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="2,0,2,2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 模式 + 狀態 -->
        <DockPanel LastChildFill="False">
            <RadioButton x:Name="CountdownTab" DockPanel.Dock="Left" Content="計時器" GroupName="Mode"
                         Style="{StaticResource Chip}" Checked="OnModeChecked" />
            <RadioButton x:Name="PomodoroTab" DockPanel.Dock="Left" Content="番茄鐘" GroupName="Mode"
                         Style="{StaticResource Chip}" Checked="OnModeChecked" />
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" FontSize="11.5"
                       Foreground="{DynamicResource Island.AccentMuted}" VerticalAlignment="Center" />
        </DockPanel>

        <!-- 大時間 + 按鈕 -->
        <Grid Grid.Row="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Background="Transparent" MouseWheel="OnTimeWheel"
                        ToolTip="滾輪可加減 1 分鐘">
                <TextBlock x:Name="TimeText" FontSize="34" FontWeight="SemiBold" Foreground="White"
                           Typography.NumeralAlignment="Tabular" />
                <Grid Height="3" Margin="0,2,16,0">
                    <Border CornerRadius="1.5" Background="{DynamicResource Island.AccentTrack}" />
                    <Border x:Name="ProgressFill" CornerRadius="1.5" Background="{DynamicResource Island.Accent}"
                            HorizontalAlignment="Left" Width="0" />
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ResetButton" Content="&#xE72C;" Style="{StaticResource RoundButton}"
                        Background="Transparent" Click="OnResetClick" ToolTip="重設" Margin="0,0,6,0" />
                <Button x:Name="SkipButton" Content="&#xE893;" Style="{StaticResource RoundButton}"
                        Background="Transparent" Click="OnSkipClick" ToolTip="跳過這一段" Margin="0,0,6,0" />
                <Button x:Name="StartButton" Content="&#xE768;" Style="{StaticResource RoundButton}"
                        Width="40" Height="40" FontSize="16" Click="OnStartClick"
                        Foreground="{DynamicResource Island.OnAccent}" Background="{DynamicResource Island.Accent}" />
            </StackPanel>
        </Grid>

        <!-- 預設時間(計時器)/ 輪數(番茄鐘) -->
        <StackPanel x:Name="Presets" Grid.Row="2" Orientation="Horizontal">
            <RadioButton Content="1 分" Tag="1" GroupName="Preset" Style="{StaticResource Chip}" Checked="OnPresetChecked" />
            <RadioButton Content="3 分" Tag="3" GroupName="Preset" Style="{StaticResource Chip}" Checked="OnPresetChecked" />
            <RadioButton Content="5 分" Tag="5" GroupName="Preset" Style="{StaticResource Chip}" Checked="OnPresetChecked" />
            <RadioButton Content="10 分" Tag="10" GroupName="Preset" Style="{StaticResource Chip}" Checked="OnPresetChecked" />
            <RadioButton Content="15 分" Tag="15" GroupName="Preset" Style="{StaticResource Chip}" Checked="OnPresetChecked" />
            <RadioButton Content="30 分" Tag="30" GroupName="Preset" Style="{StaticResource Chip}" Checked="OnPresetChecked" />
            <RadioButton Content="60 分" Tag="60" GroupName="Preset" Style="{StaticResource Chip}" Checked="OnPresetChecked" />
        </StackPanel>
        <StackPanel x:Name="Rounds" Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,4,0,4" />
    </Grid>
</UserControl>
