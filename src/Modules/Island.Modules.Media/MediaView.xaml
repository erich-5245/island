<UserControl x:Class="Island.Modules.Media.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Secondary" Color="#9A9A9A" />
        <SolidColorBrush x:Key="Dim" Color="#6E6E6E" />

        <Style x:Key="ControlButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="16" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#262626" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#4A4A4A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 有播放中的媒體 -->
        <Grid x:Name="Body" VerticalAlignment="Center" Margin="2,0,2,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 封面 -->
            <Border x:Name="Art" Width="72" Height="72" CornerRadius="12" Background="#262626">
                <TextBlock x:Name="ArtFallback" Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="24" Foreground="{StaticResource Dim}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- 歌名 / 歌手 / 來源 + 控制按鈕 -->
            <Grid Grid.Column="1" Margin="14,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="White"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ArtistText" Grid.Row="1" FontSize="12" Foreground="{StaticResource Secondary}"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                <DockPanel Grid.Row="2" VerticalAlignment="Bottom" LastChildFill="False">
                    <TextBlock x:Name="AppText" DockPanel.Dock="Left" FontSize="10.5" Foreground="{StaticResource Dim}"
                               VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,-6,-4">
                        <Button x:Name="PrevButton" Content="&#xE892;" Style="{StaticResource ControlButton}"
                                Click="OnPrevClick" ToolTip="上一首" />
                        <Button x:Name="PlayButton" Content="&#xE768;" Style="{StaticResource ControlButton}"
                                FontSize="17" Click="OnPlayClick" />
                        <Button x:Name="NextButton" Content="&#xE893;" Style="{StaticResource ControlButton}"
                                Click="OnNextClick" ToolTip="下一首" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- 進度 -->
            <Grid x:Name="ProgressRow" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionText" FontSize="10.5" Foreground="{StaticResource Secondary}"
                           VerticalAlignment="Center" MinWidth="30" />
                <Grid Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Height="4">
                    <Border CornerRadius="2" Background="#333333" />
                    <Border x:Name="ProgressFill" CornerRadius="2" Background="White" HorizontalAlignment="Left" Width="0" />
                </Grid>
                <TextBlock x:Name="DurationText" Grid.Column="2" FontSize="10.5" Foreground="{StaticResource Secondary}"
                           VerticalAlignment="Center" MinWidth="30" TextAlignment="Right" />
            </Grid>
        </Grid>

        <!-- 沒有媒體 -->
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,6">
            <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                       Foreground="{StaticResource Secondary}" HorizontalAlignment="Center" />
            <TextBlock Text="目前沒有正在播放的媒體" FontSize="12" Foreground="{StaticResource Secondary}"
                       HorizontalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
