<UserControl x:Class="Island.Modules.Links.LinksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Secondary" Color="#9A9A9A" />
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Island.AccentDim}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl x:Name="ItemsList" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="68" Height="64" Margin="1" CornerRadius="10" Padding="4,7,4,3"
                                Style="{StaticResource Tile}" ToolTip="{Binding Detail}"
                                MouseLeftButtonUp="OnTileClick">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="往前移" Click="OnMoveLeft" />
                                    <MenuItem Header="往後移" Click="OnMoveRight" />
                                    <Separator />
                                    <MenuItem Header="移除捷徑" Click="OnRemove" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel>
                                <Image Source="{Binding Icon}" Width="28" Height="28"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="White"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,6">
            <TextBlock Text="&#xE71B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                       Foreground="{StaticResource Secondary}" HorizontalAlignment="Center" />
            <TextBlock Text="還沒有捷徑" FontSize="12.5" Foreground="White" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <TextBlock Text="右鍵島 → 設定 → 捷徑,或把程式 / 資料夾拖到這裡" FontSize="11"
                       Foreground="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,3,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
