<Window x:Class="Island.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Island 設定"
        Width="780" Height="580" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Settings.WindowBg}"
        FontFamily="{StaticResource IslandFont}"
        Foreground="White"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 深色細捲軸(只用在設定視窗) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="#4A4A4D" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 左側選單 -->
        <StackPanel x:Name="Nav" Grid.RowSpan="2" Margin="12,16,8,12">
            <TextBlock Text="Island" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,14" />
        </StackPanel>

        <!-- 內容 -->
        <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel x:Name="Page" Margin="12,18,20,20" />
        </ScrollViewer>

        <!-- 需要重新啟動時出現 -->
        <Border x:Name="RestartBar" Grid.Column="1" Grid.Row="1" Margin="12,0,26,14" Padding="16,10"
                CornerRadius="10" Background="{DynamicResource Island.AccentDim}" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="重新啟動 Island" Style="{StaticResource Island.Settings.AccentButton}"
                        Click="OnRestartClick" />
                <TextBlock Text="部分變更要重新啟動 Island 才會套用" VerticalAlignment="Center" FontSize="12.5" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
