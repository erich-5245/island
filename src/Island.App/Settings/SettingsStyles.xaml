<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 設定視窗共用樣式(模組的設定頁也可以用,鍵名在 Island.Core.IslandTheme) -->

    <SolidColorBrush x:Key="Settings.WindowBg" Color="#1C1C1E" />
    <SolidColorBrush x:Key="Settings.CardBg" Color="#252527" />
    <SolidColorBrush x:Key="Settings.CardBorder" Color="#2F2F32" />
    <SolidColorBrush x:Key="Settings.Control" Color="#2C2C2E" />
    <SolidColorBrush x:Key="Settings.ControlHover" Color="#3A3A3C" />
    <SolidColorBrush x:Key="Settings.Secondary" Color="#9A9A9A" />

    <Style x:Key="Island.Settings.TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Island.Settings.CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource Settings.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="Island.Settings.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Settings.CardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Settings.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- CheckBox → 開關(開啟時是強調色) -->
    <Style x:Key="Island.Settings.Toggle" TargetType="CheckBox">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- 點一下時圓鈕滑過去、底色淡入(像 iOS 的開關) -->
                    <Grid Width="38" Height="21">
                        <Border CornerRadius="10.5" Background="#48484A" />
                        <Border x:Name="OnTrack" CornerRadius="10.5" Background="{DynamicResource Island.Accent}" Opacity="0" />
                        <Grid x:Name="Knob" Width="15" Height="15" Margin="3,0" HorizontalAlignment="Left">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="KnobShift" X="0" />
                            </Grid.RenderTransform>
                            <Ellipse Fill="White" />
                            <Ellipse x:Name="KnobOn" Fill="{DynamicResource Island.OnAccent}" Opacity="0" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 狀態用 Setter(打開頁面時直接是對的位置,不會每個開關都滑一次) -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="OnTrack" Property="Opacity" Value="1" />
                            <Setter TargetName="KnobOn" Property="Opacity" Value="1" />
                        </Trigger>
                        <!-- 只有使用者切換時才播滑動:圓鈕已經換邊,從原本的位置滑過來 -->
                        <EventTrigger RoutedEvent="ToggleButton.Checked">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" From="-17" To="0" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction><BackEase Amplitude="0.25" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" From="17" To="0" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction><BackEase Amplitude="0.25" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.15" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Island.Settings.Button" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource Settings.Control}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="8" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Island.Settings.AccentButton" TargetType="Button" BasedOn="{StaticResource Island.Settings.Button}">
        <Setter Property="Background" Value="{DynamicResource Island.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Island.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Island.Settings.TextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CaretBrush" Value="White" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Island.Accent}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg" CornerRadius="8" Background="{StaticResource Settings.Control}"
                            BorderBrush="{StaticResource Settings.ControlHover}" BorderThickness="1" Padding="8,5">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Island.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 滑桿:細軌道 + 強調色已填滿段 + 白色圓形把手 -->
    <Style x:Key="Settings.SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Settings.Slider" TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track" Height="18">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Settings.SliderFill}" Background="{DynamicResource Island.Accent}" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Settings.SliderFill}" Background="#3A3A3C" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Width="14" Height="14">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Ellipse Fill="White" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 左側選單項目 -->
    <Style x:Key="Settings.NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#CFCFCF" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="8" Padding="12,8" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#2A2A2D" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.AccentDim}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 選項(例如選螢幕):整列可點的圓角選項 -->
    <Style x:Key="Settings.Choice" TargetType="RadioButton">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="8" Padding="12,8" Background="{StaticResource Settings.Control}"
                            BorderThickness="1" BorderBrush="Transparent">
                        <DockPanel>
                            <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,10,0"
                                     Stroke="#6E6E6E" StrokeThickness="1.5" VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Settings.ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Island.Accent}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Island.Accent}" />
                            <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Island.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      下拉選單(設定視窗裡所有 ComboBox 自動套用):深灰圓角框 + 細箭頭,
      清單也是深灰底、圓角,目前選的那項用強調色標示,和右鍵選單同一套風格。
    -->
    <Style x:Key="Settings.ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" CornerRadius="8" Background="{StaticResource Settings.Control}"
                            BorderBrush="#3A3A3C" BorderThickness="1">
                        <TextBlock x:Name="Arrow" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="10" Foreground="{StaticResource Settings.Secondary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,12,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Settings.ControlHover}" />
                            <Setter TargetName="Arrow" Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Island.Accent}" />
                            <Setter TargetName="Arrow" Property="Text" Value="&#xE70E;" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource Settings.ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False" Margin="12,0,32,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left">
                            <ContentPresenter.Resources>
                                <!-- 選到的字型項目:框裡一律用一般字型顯示名稱,不要被字型本身撐高 -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="4"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="#2C2C2E" BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="10"
                                    Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" CornerRadius="6" Padding="10,6" Background="Transparent">
                        <DockPanel>
                            <TextBlock x:Name="Check" DockPanel.Dock="Right" Text="&#xE73E;" Visibility="Hidden"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{DynamicResource Island.Accent}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#3A3A3C" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Island.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
