<Window x:Class="Island.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Island"
        Width="640" Height="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource IslandFont}">

    <Window.Resources>
        <!-- 展開畫面上方的模組分頁 -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="9" Padding="9,2" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#262626" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
      視窗本身比膠囊大(預留展開空間)。
      根 Grid 沒有背景 = 像素 alpha 為 0 = 滑鼠點擊與拖放直接穿透到後面的程式。
      只有膠囊(不透明)會接收滑鼠與拖放。
    -->
    <Grid>
      <!--
        IslandRoot = 熱區 + 膠囊。滑鼠進出、拖放、右鍵選單都掛在這裡,
        這樣在「隱藏」狀態下碰到熱區也能叫出膠囊。
      -->
      <Grid x:Name="IslandRoot"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            AllowDrop="True"
            MouseEnter="OnIslandMouseEnter"
            MouseLeave="OnIslandMouseLeave"
            DragEnter="OnCapsuleDragEnter"
            DragOver="OnCapsuleDragOver"
            DragLeave="OnCapsuleDragLeave"
            Drop="OnCapsuleDrop">
        <Grid.ContextMenu>
            <ContextMenu Opened="OnContextMenuOpened">
                <MenuItem x:Name="AutoStartItem" Header="開機時啟動" IsCheckable="True" Click="OnAutoStartClick" />
                <MenuItem x:Name="HideInFullscreenItem" Header="全螢幕時隱藏" IsCheckable="True" Click="OnHideInFullscreenClick" />
                <MenuItem x:Name="HideWhenIdleItem" Header="閒置時隱藏" IsCheckable="True" Click="OnHideWhenIdleClick" />
                <MenuItem x:Name="ShowActivityItem" Header="播放中時顯示" IsCheckable="True" Click="OnShowActivityClick" />
                <Separator />
                <MenuItem Header="結束" Click="OnExitClick" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!--
          熱區:螢幕最上緣一條幾乎全透明(alpha 1/255,看不到但收得到滑鼠)的細條,
          膠囊隱藏時把滑鼠推到螢幕上緣中間就會叫出膠囊。
        -->
        <Border x:Name="HotZone" Background="#01000000"
                HorizontalAlignment="Center" VerticalAlignment="Top" />

        <Border x:Name="Capsule"
                Width="200" Height="36"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                CornerRadius="18"
                Background="{StaticResource CapsuleBrush}"
                BorderBrush="Transparent" BorderThickness="1"
                MouseLeftButtonUp="OnCapsuleClick">

            <Grid ClipToBounds="True">
                <!-- 收合層:左(預留) | 中(主模組) | 右(各模組的小提示) -->
                <Grid x:Name="CollapsedLayer" Margin="14,0" Height="34" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左側只在滑鼠移過去(預覽)時淡入,例如日期 -->
                    <ContentControl x:Name="LeftSlot" Grid.Column="0" Opacity="0" ClipToBounds="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Focusable="False" />

                    <ContentControl x:Name="CenterSlot" Grid.Column="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />

                    <StackPanel x:Name="BadgeStrip" Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <!-- 模組有活動(例如正在播放)且不是預覽時,取代上面三格 -->
                    <ContentControl x:Name="ActivitySlot" Grid.ColumnSpan="3" Opacity="0"
                                    IsHitTestVisible="False" Focusable="False"
                                    VerticalAlignment="Center" />
                </Grid>

                <!--
                  展開層:固定為展開後的尺寸並置中,膠囊放大時像「揭開」一樣出現,
                  不會在動畫過程中反覆重新排版。
                -->
                <Grid x:Name="ExpandedLayer"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Visibility="Collapsed" Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="TabStrip" Grid.Row="0"
                                Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,8,0,0" />

                    <ContentControl x:Name="ExpandedSlot" Grid.Row="1"
                                    Margin="12,6,12,10" Focusable="False" />
                </Grid>
            </Grid>
        </Border>
      </Grid>
    </Grid>
</Window>
