<Window x:Class="Island.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Island"
        Width="640" Height="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource IslandFont}">

    <Window.Resources>
        <!-- 展開畫面上方的模組分頁 -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="12" Height="24" Padding="10,0" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.AccentDim}" />
                                <Setter Property="Foreground" Value="{DynamicResource Island.AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 圓形小圖示按鈕(設定齒輪、開始):和分頁一樣高,垂直置中對齊 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="#8A8A8A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="24" Height="24" CornerRadius="12" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A2A2A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 標誌(四個小方塊),顏色跟著按鈕的前景 -->
        <DataTemplate x:Key="StartGlyph">
            <Path Data="M0,0 H5 V5 H0 Z M6,0 H11 V5 H6 Z M0,6 H5 V11 H0 Z M6,6 H11 V11 H6 Z"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </DataTemplate>
    </Window.Resources>

    <!--
      視窗本身比膠囊大(預留展開空間)。
      根 Grid 沒有背景 = 像素 alpha 為 0 = 滑鼠點擊與拖放直接穿透到後面的程式。
      只有膠囊(不透明)會接收滑鼠與拖放。
    -->
    <Grid>
      <!--
        IslandRoot = 熱區 + 膠囊。滑鼠進出、拖放、右鍵選單都掛在這裡,
        這樣在「隱藏」狀態下碰到熱區也能叫出膠囊。
      -->
      <Grid x:Name="IslandRoot"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            AllowDrop="True"
            MouseEnter="OnIslandMouseEnter"
            MouseLeave="OnIslandMouseLeave"
            DragEnter="OnCapsuleDragEnter"
            DragOver="OnCapsuleDragOver"
            DragLeave="OnCapsuleDragLeave"
            Drop="OnCapsuleDrop">
        <Grid.ContextMenu>
            <ContextMenu Opened="OnContextMenuOpened">
                <MenuItem x:Name="AutoStartItem" Header="開機時啟動" IsCheckable="True" StaysOpenOnClick="True" Click="OnAutoStartClick" />
                <MenuItem x:Name="HideInFullscreenItem" Header="全螢幕時隱藏" IsCheckable="True" StaysOpenOnClick="True" Click="OnHideInFullscreenClick" />
                <MenuItem x:Name="HideWhenIdleItem" Header="閒置時隱藏" IsCheckable="True" StaysOpenOnClick="True" Click="OnHideWhenIdleClick" />
                <MenuItem x:Name="AnnounceItem" Header="切歌時顯示" IsCheckable="True" StaysOpenOnClick="True" Click="OnAnnounceClick" />
                <MenuItem x:Name="OsdItem" Header="音量亮度提示" IsCheckable="True" StaysOpenOnClick="True" Click="OnOsdClick" />
                <Separator />
                <MenuItem Header="設定…" Click="OnSettingsClick" />
                <MenuItem Header="結束" Click="OnExitClick" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!--
          熱區:螢幕最上緣一條幾乎全透明(alpha 1/255,看不到但收得到滑鼠)的細條,
          膠囊隱藏時把滑鼠推到螢幕上緣中間就會叫出膠囊。
        -->
        <Border x:Name="HotZone" Background="#01000000"
                HorizontalAlignment="Center" VerticalAlignment="Top" />

        <!-- 小瀏海(設定可開):隱藏時螢幕上緣中間留一小段,提醒島在這裡;滑鼠碰到一樣是熱區 -->
        <Border x:Name="Notch" Width="64" Height="5" CornerRadius="0,0,3,3" IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed"
                Background="{DynamicResource CapsuleBrush}" />

        <!-- 左小圓 | 膠囊(長條)| 右小圓:滑鼠移過去且同時有多個即時狀態時,兩側出現小圓 -->
        <StackPanel x:Name="IslandRow" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Top">

        <Border x:Name="LeftCircle" Width="36" Height="36" CornerRadius="18" Margin="0,0,6,0"
                VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" Cursor="Hand"
                Background="{DynamicResource CapsuleBrush}"
                BorderBrush="{DynamicResource Island.CapsuleBorder}" BorderThickness="1"
                MouseLeftButtonUp="OnCircleClick" MouseEnter="OnCircleMouseEnter" MouseLeave="OnCircleMouseLeave">
            <Grid>
                <ContentControl x:Name="LeftCircleSlot" Focusable="False" IsHitTestVisible="False"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- 滑鼠停留時往外延伸的內容(例如開著的視窗);Canvas 讓內容量出自己真正的寬度 -->
                <Canvas x:Name="LeftCircleStrip" ClipToBounds="True" Visibility="Collapsed" />
            </Grid>
        </Border>

        <Border x:Name="Capsule"
                Width="200" Height="36"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                CornerRadius="18"
                Background="{DynamicResource CapsuleBrush}"
                BorderBrush="{DynamicResource Island.CapsuleBorder}" BorderThickness="1"
                MouseLeftButtonUp="OnCapsuleClick">

            <Grid ClipToBounds="True">
                <!-- 收合層:左(預留) | 中(主模組) | 右(各模組的小提示) -->
                <Grid x:Name="CollapsedLayer" Margin="14,0" Height="34" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左側只在滑鼠移過去(預覽)時淡入,例如日期 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <!-- 開始(設定選「一排的左邊」時):和日期一起淡入淡出 -->
                        <Button x:Name="PeekStartButton" Style="{StaticResource IconButton}" ToolTip="開始"
                                ContentTemplate="{StaticResource StartGlyph}" Content="" Margin="-6,0,4,0"
                                Visibility="Collapsed" Click="OnStartClick"
                                Opacity="{Binding Opacity, ElementName=LeftSlot}" />
                        <ContentControl x:Name="LeftSlot" Opacity="0" ClipToBounds="True"
                                        VerticalAlignment="Center" Focusable="False" />
                    </StackPanel>

                    <ContentControl x:Name="CenterSlot" Grid.Column="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />

                    <StackPanel x:Name="BadgeStrip" Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <!-- 模組有活動(例如正在播放)時,預覽與「切歌提示」改顯示活動畫面,取代上面三格 -->
                    <ContentControl x:Name="ActivitySlot" Grid.ColumnSpan="3" Opacity="0"
                                    IsHitTestVisible="False" Focusable="False"
                                    VerticalAlignment="Center" />
                </Grid>

                <!--
                  展開層:固定為展開後的尺寸並置中,膠囊放大時像「揭開」一樣出現,
                  不會在動畫過程中反覆重新排版。
                -->
                <Grid x:Name="ExpandedLayer"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Visibility="Collapsed" Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                      分頁那一排:[左邊留白(和右邊工具一樣寬,分頁才會置中)] [分頁(放不下時可用滾輪左右捲)] [開始 / 設定]
                      分頁和圖示按鈕都是 24 高、垂直置中,所以會對齊。
                    -->
                    <Grid x:Name="TabRow" Grid.Row="0" Margin="10,8,10,0" Height="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="TabBalance" Width="0" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer x:Name="TabScroller" Grid.Column="1" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="OnTabWheel" ScrollChanged="OnTabScrollChanged">
                            <StackPanel x:Name="TabStrip" Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </ScrollViewer>
                        <StackPanel x:Name="TabTools" Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0"
                                    VerticalAlignment="Center" SizeChanged="OnTabRowSizeChanged">
                            <Button x:Name="TabStartButton" Style="{StaticResource IconButton}" ToolTip="開始"
                                    ContentTemplate="{StaticResource StartGlyph}" Content="" Margin="0,0,2,0"
                                    Visibility="Collapsed" Click="OnStartClick" />
                            <!-- 設定,不用再按右鍵選單 -->
                            <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" ToolTip="設定"
                                    Click="OnSettingsButtonClick">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ContentControl x:Name="ExpandedSlot" Grid.Row="1"
                                    Margin="12,6,12,10" Focusable="False" />

                </Grid>
            </Grid>
        </Border>

        <Border x:Name="RightCircle" Width="36" Height="36" CornerRadius="18" Margin="6,0,0,0"
                VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" Cursor="Hand"
                Background="{DynamicResource CapsuleBrush}"
                BorderBrush="{DynamicResource Island.CapsuleBorder}" BorderThickness="1"
                MouseLeftButtonUp="OnCircleClick" MouseEnter="OnCircleMouseEnter" MouseLeave="OnCircleMouseLeave">
            <Grid>
                <ContentControl x:Name="RightCircleSlot" Focusable="False" IsHitTestVisible="False"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- 滑鼠停留時往外延伸的內容(例如開著的視窗);Canvas 讓內容量出自己真正的寬度 -->
                <Canvas x:Name="RightCircleStrip" ClipToBounds="True" Visibility="Collapsed" />
            </Grid>
        </Border>

        </StackPanel>
      </Grid>
    </Grid>
</Window>
