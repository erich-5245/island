<Project>
  <!-- ???獢?函?閮剖? -->
  <PropertyGroup>
    <!-- 10.0.19041 = 可使用 Windows 執行階段 API(例如媒體模組的 GlobalSystemMediaTransportControls) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <!-- 讓 tests\Island.Tests 可以測試 internal 的純邏輯 -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Island.Tests'">
    <InternalsVisibleTo Include="Island.Tests" />
  </ItemGroup>
</Project>
